<Window x:Class="PdfExtractToSkill.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to PDF Extract to Skill" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">

        <!-- Step 1: Prerequisites -->
        <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Step 1 of 3 — Prerequisites" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding PrerequisiteStatus}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Button Content="Next →" Command="{Binding NextCommand}"
                    HorizontalAlignment="Right" Width="80"/>
        </StackPanel>

        <!-- Step 2: Folder paths -->
        <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Step 2 of 3 — Folders" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="Folder to watch for new PDFs" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Browse…"
                        Command="{Binding BrowseRootPathCommand}" Width="72" Margin="4,0,0,0"/>
                <TextBox Text="{Binding WatchedRootPath, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <TextBlock Text="Output folder for extracted skills" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Browse…"
                        Command="{Binding BrowseOutputPathCommand}" Width="72" Margin="4,0,0,0"/>
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <Button Content="Next →" Command="{Binding NextCommand}"
                    HorizontalAlignment="Right" Width="80"/>
        </StackPanel>

        <!-- Step 3: Confirm -->
        <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Step 3 of 3 — Confirm" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                <Run Text="Watch folder: "/>
                <Run Text="{Binding WatchedRootPath}" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16">
                <Run Text="Output folder: "/>
                <Run Text="{Binding OutputPath}" FontWeight="SemiBold"/>
            </TextBlock>
            <Button Content="Start Watching" Command="{Binding FinishCommand}"
                    HorizontalAlignment="Right" Width="120" IsDefault="True"/>
        </StackPanel>

    </StackPanel>
</Window>
