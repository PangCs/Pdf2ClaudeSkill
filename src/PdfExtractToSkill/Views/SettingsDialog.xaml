<Window x:Class="PdfExtractToSkill.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">

        <!-- Watched root path -->
        <TextBlock Text="Watch folder" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Browse…"
                    Command="{Binding BrowseRootPathCommand}" Width="72" Margin="4,0,0,0"/>
            <TextBox Text="{Binding WatchedRootPath, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <!-- Output path -->
        <TextBlock Text="Output folder" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Browse…"
                    Command="{Binding BrowseOutputPathCommand}" Width="72" Margin="4,0,0,0"/>
            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <!-- Python override -->
        <TextBlock Text="Python executable (optional override)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Browse…"
                    Command="{Binding BrowsePythonCommand}" Width="72" Margin="4,0,0,0"/>
            <TextBox Text="{Binding PythonExePath, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <!-- Autostart -->
        <CheckBox Content="Start automatically with Windows"
                  IsChecked="{Binding AutostartEnabled}"
                  Margin="0,0,0,12"/>

        <!-- Prerequisites -->
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Check"
                    Command="{Binding CheckPrerequisitesCommand}" Width="72" Margin="4,0,0,0"/>
            <TextBlock Text="Prerequisites" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding PrerequisiteStatus}" TextWrapping="Wrap"
                   Margin="0,0,0,12" Foreground="Gray" FontStyle="Italic"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}" Width="80" IsDefault="True"/>
        </StackPanel>

    </StackPanel>
</Window>
