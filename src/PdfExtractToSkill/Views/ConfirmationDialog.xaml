<Window x:Class="PdfExtractToSkill.Views.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extract PDF to Skill"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Skill name" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Text="{Binding SkillName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
        <TextBlock Foreground="OrangeRed" Margin="0,0,0,8"
                   Visibility="{Binding SkillAlreadyExists, Converter={StaticResource BoolToVisibility}}">
            A skill with this name already exists.
        </TextBlock>

        <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

        <CheckBox Content="Overwrite existing skill"
                  IsChecked="{Binding OverwriteConfirmed}"
                  Visibility="{Binding SkillAlreadyExists, Converter={StaticResource BoolToVisibility}}"
                  Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"  Command="{Binding CancelCommand}"  Width="80" Margin="0,0,8,0"/>
            <Button Content="Extract" Command="{Binding ConfirmCommand}" Width="80" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
