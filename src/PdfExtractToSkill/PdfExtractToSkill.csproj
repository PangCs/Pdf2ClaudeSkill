<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PdfExtractToSkill.Application\PdfExtractToSkill.Application.csproj" />
    <ProjectReference Include="..\PdfExtractToSkill.Contracts\PdfExtractToSkill.Contracts.csproj" />
    <ProjectReference Include="..\PdfExtractToSkill.Infrastructure\PdfExtractToSkill.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\extract.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>extract.py</Link>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
